# Dart / Flutter
.dart_tool/
build/
.flutter-plugins*
.packages
pubspec.lock

# Server runtime state (seeded on boot; never committed)
server/data/

# Secrets (never commit real values)
.env
.env*.local

# Python runtime / venv
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local runtime state
*.db
*.log

# ML training artifacts (dataset, checkpoints — never committed)
ai-service/data/
ai-service/models/*.pt

# OS
.DS_Store
