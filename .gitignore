# Dart / Flutter
.dart_tool/
build/
.flutter-plugins*
.packages
# Dart lock file: excluded for library packages only (see shared/.gitignore).
# The Flutter application (mobile/) MUST commit its pubspec.lock.
# Run `flutter pub get` in mobile/ then `git add mobile/pubspec.lock`.
shared/pubspec.lock

# Server runtime state (seeded on boot; never committed)
server/data/

# Secrets (never commit real values)
.env
.env*.local

# Python runtime / venv
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Local runtime state
*.db
*.log

# ML training artifacts (dataset, checkpoints — never committed)
ai-service/data/
ai-service/models/*.pt
ai-service/models/*.onnx

# OS
.DS_Store

# Mosquitto credentials (generated per environment; NEVER commit)
infra/mosquitto/passwd
.dev-mosquitto.passwd
.dev-mosquitto.acl
