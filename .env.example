# =============================================================================
# Recycle Vision / EcoLoop — local development environment
# Copy to `.env` and adjust. Every service reads its own values from env.
# =============================================================================

# ---- Backend (backend/) ------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://recycle:recycle@localhost:5432/recycle_vision
# For a zero-dependency local run (no Postgres), you may use SQLite instead:
# DATABASE_URL=sqlite:///./recycle.db

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

AI_SERVICE_URL=http://localhost:8051

JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256

SEED_ON_STARTUP=true
DEBUG=false

# Deposit policy
MIN_DEPOSIT_WEIGHT_GRAMS=1.0
AI_HIGH_CONFIDENCE=0.80
AI_MEDIUM_CONFIDENCE=0.50
DEPOSIT_SESSION_TTL_SECONDS=300

# ---- AI service (ai-service/) ------------------------------------------------
AI_SERVICE_CLASSIFIER=development
# AI_SERVICE_CLASSIFIER=real            # once a trained model exists
AI_MODEL_PATH=
DEVELOPMENT_FORCE_CLASS=
DEVELOPMENT_FORCE_CONFIDENCE=

# ---- Hardware simulator (hardware-simulator/) --------------------------------
STATION_ID=st-001
STATION_CODE=ST-001
SIMULATOR_MOVEMENT_TIME=0.3
SIMULATOR_SENSOR_NOISE=0.2
MIN_DEPOSIT_WEIGHT_GRAMS=1.0
SIMULATOR_RAMP_STEP=0.05          # set to 0 for instant ramps (tests/CI)
