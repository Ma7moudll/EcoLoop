# ============================================================
# EcoLoop Docker Compose — environment variables
# Copy this file to infra/.env and fill in your values.
# NEVER commit infra/.env (it is git-ignored).
# NEVER put real credentials in THIS file — placeholders only.
# ============================================================

# ---- MQTT (HiveMQ Cloud or self-hosted) ---------------------
MQTT_BROKER_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=your-mqtt-user
MQTT_PASSWORD=supply_via_secret_store

# ---- Backend secrets ----------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# Shared key authenticating the station camera.
STATION_API_KEY=CHANGE_ME_generate_a_strong_random_key

# ---- Database (optional override) ---------------------------
# Default: recycle (acceptable for local Docker only)
# POSTGRES_PASSWORD=recycle

# ---- CORS ---------------------------------------------------
# ALLOWED_ORIGINS=https://yourdomain.com

# ---- Environment -------------------------------------------
ENVIRONMENT=development

# ---- AI service ---------------------------------------------
# Defensive /predict upload cap in bytes (default 10485760 = 10 MB).
# AI_MAX_UPLOAD_BYTES=10485760
